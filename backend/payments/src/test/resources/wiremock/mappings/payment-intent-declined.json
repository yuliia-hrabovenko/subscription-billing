{
  "name": "stripe-payment-intent-declined",
  "request": {
    "method": "POST",
    "urlPath": "/v1/payment_intents",
    "bodyPatterns": [
      { "contains": "payment_method=pm_cardDeclined" }
    ]
  },
  "response": {
    "status": 402,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "error": {
        "type": "card_error",
        "code": "card_declined",
        "decline_code": "generic_decline",
        "message": "Your card was declined.",
        "payment_intent": { "id": "pi_3PstripeDeclined001" },
        "doc_url": "https://stripe.com/docs/error-codes/card-declined"
      }
    }
  }
}
